{
  "name": "parallel-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "demo": "npm run build -w @parallel/desktop && node scripts/run-demo.mjs",
    "evaluate": "tsx scripts/evaluate-gold.mjs",
    "verify": "tsx scripts/verify-privacy.mjs",
    "smoke:live": "tsx scripts/smoke-live.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
