# Server-only. The bundled fixed demo works without either credential.
# Never expose these variables with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
# Optional teaching-source enrichment. Recognition and deterministic
# compilation remain available when Exa is absent or temporarily unavailable.
EXA_API_KEY=
# Optional override. Leave empty to use the verified default.
OPENAI_RECOGNITION_MODEL=
